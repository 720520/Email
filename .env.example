# 可选：指定 YAML 配置文件。相对路径以项目根目录为基准。
FUND_NAV_CONFIG_FILE=config/config.yaml

# 敏感配置请在本机 .env 中取消注释并填写，不要写入仓库。
# FUND_NAV_EMAIL__PASSWORD=replace-with-mail-authorization-code

# 生产环境必须取消下一行注释，设置至少 32 位的随机会话密钥，并启用安全 Cookie。
# FUND_NAV_SECURITY__SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# FUND_NAV_SECURITY__CREDENTIAL_ENCRYPTION_KEY=replace-with-a-url-safe-base64-32-byte-key
# FUND_NAV_SECURITY__AUDIT_SIGNING_KEY=replace-with-another-url-safe-base64-32-byte-key
# FUND_NAV_SECURITY__SECURE_COOKIE=true

# 批量报表 Worker，默认并发数为 2。
# FUND_NAV_REPORTS__WORKER_CONCURRENCY=2
# FUND_NAV_REPORTS__WORKER_POLL_SECONDS=2
# FUND_NAV_REPORTS__WORKER_STALE_MINUTES=15

# 必须与 compose.onlyoffice.yaml 中 Document Server 使用同一密钥；一键启动会自动补齐。
# FUND_NAV_ONLYOFFICE__JWT_SECRET=replace-with-an-independent-random-secret

# Outlook / Microsoft 365 使用现代认证时改为 oauth2，并注入短期访问令牌。
# FUND_NAV_EMAIL__AUTH_MODE=oauth2
# FUND_NAV_EMAIL__OAUTH2_ACCESS_TOKEN=
