# 可选：指定 YAML 配置文件。相对路径以项目根目录为基准。
FUND_NAV_CONFIG_FILE=config/config.yaml

# 敏感配置请在本机 .env 中取消注释并填写，不要写入仓库。
# FUND_NAV_EMAIL__PASSWORD=replace-with-mail-authorization-code

# 生产环境必须取消下一行注释，设置至少 32 位的随机会话密钥，并启用安全 Cookie。
# FUND_NAV_SECURITY__SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# FUND_NAV_SECURITY__SECURE_COOKIE=true

# Outlook / Microsoft 365 使用现代认证时改为 oauth2，并注入短期访问令牌。
# FUND_NAV_EMAIL__AUTH_MODE=oauth2
# FUND_NAV_EMAIL__OAUTH2_ACCESS_TOKEN=
